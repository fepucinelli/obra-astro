---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  section: string;
}

const { title, section } = Astro.props;

const navItems = [
  { label: "Dashboard", href: "/admin", section: "dashboard" },
  { label: "Blog", href: "/admin/blog", section: "blog" },
  { label: "Novo Post", href: "/admin/blog/new", section: "blog-new" },
  { label: "Eventos", href: "/admin/events", section: "events" },
  { label: "Novo Evento", href: "/admin/events/new", section: "events-new" },
  { label: "Podcasts", href: "/admin/podcasts", section: "podcasts" },
  { label: "Novo Podcast", href: "/admin/podcasts/new", section: "podcasts-new" },
];

const groups = [
  {
    label: "Blog",
    items: navItems.filter(i => i.section === "blog" || i.section === "blog-new"),
  },
  {
    label: "Eventos",
    items: navItems.filter(i => i.section === "events" || i.section === "events-new"),
  },
  {
    label: "Podcasts",
    items: navItems.filter(i => i.section === "podcasts" || i.section === "podcasts-new"),
  },
];
---

<BaseLayout title={`Admin — ${title}`}>
  <div class="admin-shell flex min-h-[calc(100vh-4rem)]">

    <!-- Sidebar -->
    <aside class="admin-sidebar w-56 shrink-0 border-r border-obra-muted/30 bg-obra-card flex flex-col">

      <!-- Sidebar header -->
      <div class="px-5 py-5 border-b border-obra-muted/30">
        <p class="font-mono text-xs tracking-widest text-obra-muted uppercase mb-1">Admin</p>
        <a
          href="/admin"
          class="font-mono text-sm font-bold tracking-widest text-obra-white hover:text-obra-accent transition-colors"
        >
          OBRA CMS
        </a>
      </div>

      <!-- Nav -->
      <nav class="flex-1 px-4 py-5 overflow-y-auto" aria-label="Admin navigation">

        <!-- Dashboard link -->
        <a
          href="/admin"
          class:list={[
            "flex items-center gap-2 px-3 py-2 mb-4 font-mono text-xs tracking-widest uppercase transition-colors rounded-sm",
            section === "dashboard"
              ? "text-obra-accent bg-obra-accent/10"
              : "text-obra-muted hover:text-obra-white",
          ]}
        >
          <span class="text-obra-accent select-none">›</span>
          Dashboard
        </a>

        <!-- Grouped nav items -->
        {groups.map((group) => (
          <div class="mb-5">
            <p class="font-mono text-[10px] tracking-widest text-obra-muted/60 uppercase px-3 mb-1">
              {group.label}
            </p>
            <ul class="space-y-0.5">
              {group.items.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class:list={[
                      "flex items-center gap-2 px-3 py-2 font-mono text-xs tracking-widest uppercase transition-colors rounded-sm",
                      section === item.section
                        ? "text-obra-accent bg-obra-accent/10"
                        : "text-obra-muted hover:text-obra-white",
                    ]}
                  >
                    <span class="text-obra-accent/50 select-none">›</span>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>

      <!-- Sidebar footer — logout -->
      <div class="px-4 py-4 border-t border-obra-muted/30">
        <a
          href="/auth/logout"
          class="flex items-center gap-2 px-3 py-2 w-full font-mono text-xs tracking-widest uppercase text-obra-muted hover:text-obra-accent transition-colors rounded-sm"
        >
          <span class="select-none">↩</span>
          Logout
        </a>
      </div>
    </aside>

    <!-- Main content area -->
    <div class="admin-main flex-1 overflow-y-auto">

      <!-- Content header -->
      <div class="border-b border-obra-muted/30 px-8 py-5">
        <h1 class="font-mono text-sm font-bold tracking-widest uppercase text-obra-white">
          {title}
        </h1>
      </div>

      <!-- Slot -->
      <div class="px-8 py-8">
        <slot />
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* Ensure the admin shell fills height properly below the fixed header */
  .admin-shell {
    min-height: calc(100vh - 4rem);
  }

  /* Sidebar scrollbar — minimal */
  .admin-sidebar nav::-webkit-scrollbar {
    width: 2px;
  }

  .admin-sidebar nav::-webkit-scrollbar-thumb {
    background-color: #444;
  }
</style>
