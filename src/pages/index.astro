---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getAllPosts, getAllEvents, getAllPodcasts } from "../lib/payload";

// Get content (already sorted by -date from Payload)
const [latestPost] = await getAllPosts();
const [latestEvent] = await getAllEvents();
const [latestPodcast] = await getAllPodcasts();

// Format date helper
function formatDate(date: Date) {
  return new Intl.DateTimeFormat("pt-BR", { day: "2-digit", month: "2-digit" }).format(date);
}

// Category label map
const categoryLabels: Record<string, string> = {
  "evento-interno": "EVENTO INTERNO",
  "evento-rua": "EVENTO RUA",
  "evento-coletivo": "COLETIVO",
};
---

<BaseLayout
  title="Início"
  description="Obra — Coletivo de música eletrônica do Brasil. Techno, experimental, underground."
>
  <!-- ═══════════════════════════════════════════════════
       HERO
  ══════════════════════════════════════════════════════ -->
  <section class="hero" aria-label="Hero">
    <!-- Geometric CSS animation canvas -->
    <div class="hero-geo" aria-hidden="true">
      <div class="geo geo-rect-1"></div>
      <div class="geo geo-rect-2"></div>
      <div class="geo geo-line-1"></div>
      <div class="geo geo-line-2"></div>
      <div class="geo geo-line-3"></div>
      <div class="geo geo-circle"></div>
      <div class="geo geo-cross-h"></div>
      <div class="geo geo-cross-v"></div>
      <div class="geo geo-dot-grid"></div>
      <div class="geo geo-slash"></div>
    </div>

    <!-- Hero content -->
    <div class="hero-content">
      <span class="hero-label">COLETIVO&nbsp;/&nbsp;BRASIL</span>
      <h1 class="hero-wordmark">OBRA</h1>
      <p class="hero-tagline">Música eletrônica underground.<br />Techno. Experimental. Resistência.</p>
      <a href="/about" class="hero-cta">
        <span>SOBRE O COLETIVO</span>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>

    <!-- Marquee ticker -->
    <div class="hero-ticker" aria-hidden="true">
      <div class="ticker-track">
        {Array.from({ length: 6 }).map(() => (
          <span class="ticker-text">
            MÚSICA ELETRÔNICA&nbsp;&mdash;&nbsp;COLETIVO&nbsp;&mdash;&nbsp;SÃO PAULO&nbsp;&mdash;&nbsp;UNDERGROUND&nbsp;&mdash;&nbsp;RESISTÊNCIA&nbsp;&mdash;&nbsp;
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       HIGHLIGHTS GRID
  ══════════════════════════════════════════════════════ -->
  <section class="highlights" aria-label="Destaques">
    <div class="highlights-grid">

      <!-- ── LATEST BLOG POST (large card, spans 2 cols) ── -->
      {latestPost && (
        <article class="card card-post reveal">
          <div class="card-img-wrap">
            {latestPost.cover ? (
              <img
                src={latestPost.cover}
                alt={latestPost.title}
                class="card-img"
                fetchpriority="high"
                loading="eager"
                decoding="async"
              />
            ) : (
              <div class="card-img-placeholder" aria-hidden="true">
                <span>OBRA</span>
              </div>
            )}
            <div class="card-img-overlay" aria-hidden="true"></div>
          </div>

          <div class="card-body">
            <span class="section-label">— ÚLTIMA POSTAGEM</span>
            <div class="card-meta-row">
              {latestPost.category && (
                <span class="category-pill">
                  {categoryLabels[latestPost.category] ?? latestPost.category}
                </span>
              )}
              <time class="card-date" datetime={latestPost.date.toISOString()}>
                {formatDate(latestPost.date)}
              </time>
            </div>
            <h2 class="card-title">{latestPost.title}</h2>
            {latestPost.description && (
              <p class="card-desc">{latestPost.description}</p>
            )}
            <a href={`/blog/${latestPost.slug}`} class="card-link link-underline">
              LER MAIS
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
        </article>
      )}

      <!-- ── SIDEBAR: EVENT + PODCAST ── -->
      <div class="card-sidebar">

        <!-- LATEST EVENT -->
        {latestEvent && (
          <article class="card card-event reveal" style="--reveal-delay: 0.15s">
            <span class="section-label">— PRÓXIMO EVENTO</span>
            <div class="event-date-block">
              <span class="event-day">
                {latestEvent.date.toLocaleDateString("pt-BR", { day: "2-digit" })}
              </span>
              <span class="event-month">
                {latestEvent.date.toLocaleDateString("pt-BR", { month: "short" }).toUpperCase().replace(".", "")}
              </span>
            </div>
            <h2 class="card-title card-title--event">{latestEvent.name}</h2>
            {latestEvent.location && (
              <p class="event-location">
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true" style="display:inline;vertical-align:middle;margin-right:4px">
                  <circle cx="6" cy="5" r="2" stroke="currentColor" stroke-width="1.2"/>
                  <path d="M6 1C3.79 1 2 2.79 2 5c0 3 4 7 4 7s4-4 4-7c0-2.21-1.79-4-4-4z" stroke="currentColor" stroke-width="1.2" fill="none"/>
                </svg>
                {latestEvent.location}
              </p>
            )}
            {latestEvent.description && (
              <p class="card-desc card-desc--sm">{latestEvent.description}</p>
            )}
            <div class="event-links">
              <a href={`/events/${latestEvent.slug}`} class="card-link link-underline">VER EVENTO</a>
              {latestEvent.ticketUrl && (
                <a href={latestEvent.ticketUrl} class="btn-ticket" target="_blank" rel="noopener noreferrer">
                  INGRESSOS →
                </a>
              )}
            </div>
          </article>
        )}

        <!-- LATEST PODCAST -->
        {latestPodcast && (
          <article class="card card-podcast reveal" style="--reveal-delay: 0.3s">
            <span class="section-label">— ÚLTIMO PODCAST</span>
            <div class="podcast-icon" aria-hidden="true">
              <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="24" cy="24" r="22" stroke="currentColor" stroke-width="1.5"/>
                <circle cx="24" cy="24" r="8" fill="currentColor" opacity="0.15"/>
                <circle cx="24" cy="24" r="3" fill="currentColor"/>
                <path d="M10 24a14 14 0 0114-14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M38 24a14 14 0 01-14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M16 24a8 8 0 018-8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M32 24a8 8 0 01-8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </div>
            <h2 class="card-title card-title--podcast">{latestPodcast.title}</h2>
            {latestPodcast.duration && (
              <span class="podcast-duration">{latestPodcast.duration}</span>
            )}
            {latestPodcast.description && (
              <p class="card-desc card-desc--sm">{latestPodcast.description}</p>
            )}
            <div class="podcast-embed-hint" aria-hidden="true">
              <span class="embed-bar"></span>
              <span class="embed-bar"></span>
              <span class="embed-bar"></span>
              <span class="embed-bar"></span>
              <span class="embed-bar"></span>
              <span class="embed-bar"></span>
              <span class="embed-bar"></span>
              <span class="embed-bar"></span>
              <span class="embed-bar"></span>
            </div>
            <a href={`/podcasts/${latestPodcast.slug}`} class="card-link link-underline">OUVIR AGORA</a>
          </article>
        )}

      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       MANIFESTO
  ══════════════════════════════════════════════════════ -->
  <section class="manifesto reveal" aria-label="Manifesto">
    <div class="manifesto-inner">
      <p class="manifesto-text">
        <span class="manifesto-obra">OBRA</span> é um coletivo de música eletrônica
        nascido nas periferias sonoras de São Paulo.
        Criamos espaços de escuta, resistência e celebração —
        nos largos, nos porões, nos estúdios improvisados.
        O underground não é nicho. É território.
      </p>
      <a href="/about" class="manifesto-link">
        <span>LEIA O MANIFESTO COMPLETO</span>
        <div class="manifesto-line" aria-hidden="true"></div>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
/* ─── HERO ────────────────────────────────────────────────── */
.hero {
  position: relative;
  min-height: 90vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  overflow: hidden;
  margin-top: -4rem; /* overlap header */
  background-color: #080808;
  isolation: isolate;
  contain: layout;
}

/* ── Geometric animation canvas ── */
.hero-geo {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

/* Base geo styles */
.geo {
  position: absolute;
}

/* Rect 1 — large acid outline rect, rotates slowly */
.geo-rect-1 {
  right: 5%;
  top: 15%;
  width: clamp(200px, 28vw, 480px);
  height: clamp(200px, 28vw, 480px);
  border: 1.5px solid #C8FF00;
  opacity: 0.55;
  animation: geoRotate1 28s linear infinite;
  transform-origin: center;
  will-change: transform;
}

/* Rect 2 — smaller, offset, counter-rotates */
.geo-rect-2 {
  right: 10%;
  top: 22%;
  width: clamp(120px, 16vw, 280px);
  height: clamp(120px, 16vw, 280px);
  border: 1px solid #C8FF00;
  opacity: 0.25;
  animation: geoRotate2 20s linear infinite reverse;
  transform-origin: center;
  will-change: transform;
}

/* Line 1 — horizontal scan */
.geo-line-1 {
  right: 0;
  top: 38%;
  width: clamp(300px, 42vw, 640px);
  height: 1px;
  background: linear-gradient(90deg, transparent, #C8FF00 40%, transparent);
  opacity: 0.5;
  animation: geoPulse 4s ease-in-out infinite;
}

/* Line 2 — vertical */
.geo-line-2 {
  right: clamp(200px, 22vw, 380px);
  top: 0;
  width: 1px;
  height: 60vh;
  background: linear-gradient(180deg, transparent, #C8FF00 50%, transparent);
  opacity: 0.3;
  animation: geoPulse 6s ease-in-out infinite 1s;
}

/* Line 3 — diagonal slash accent */
.geo-slash {
  right: 6%;
  top: 8%;
  width: clamp(240px, 32vw, 520px);
  height: clamp(240px, 32vw, 520px);
  border-bottom: 1px solid #C8FF00;
  opacity: 0.18;
  transform: rotate(-35deg);
  transform-origin: bottom right;
  animation: geoSlash 12s ease-in-out infinite;
}

/* Line 3 */
.geo-line-3 {
  right: clamp(120px, 14vw, 240px);
  bottom: 25%;
  width: clamp(60px, 8vw, 140px);
  height: 1px;
  background: #C8FF00;
  opacity: 0.6;
  animation: geoFlicker 3s step-end infinite;
}

/* Circle — pulsing */
.geo-circle {
  right: calc(clamp(200px, 28vw, 480px) / 2 + 5% - clamp(60px, 8vw, 120px) / 2);
  top: calc(15% + clamp(200px, 28vw, 480px) / 2 - clamp(60px, 8vw, 120px) / 2);
  width: clamp(60px, 8vw, 120px);
  height: clamp(60px, 8vw, 120px);
  border-radius: 50%;
  border: 1px solid #C8FF00;
  opacity: 0.4;
  animation: geoCirclePulse 5s ease-in-out infinite;
}

/* Cross lines */
.geo-cross-h {
  right: 8%;
  top: 50%;
  width: clamp(16px, 2.5vw, 40px);
  height: 1px;
  background: #C8FF00;
  opacity: 0.8;
}

.geo-cross-v {
  right: calc(8% + clamp(16px, 2.5vw, 40px) / 2 - 0.5px);
  top: calc(50% - clamp(8px, 1.25vw, 20px));
  width: 1px;
  height: clamp(16px, 2.5vw, 40px);
  background: #C8FF00;
  opacity: 0.8;
}

/* Dot grid */
.geo-dot-grid {
  right: 5%;
  bottom: 18%;
  width: clamp(80px, 10vw, 160px);
  height: clamp(40px, 5vw, 80px);
  background-image: radial-gradient(circle, #C8FF00 1px, transparent 1px);
  background-size: clamp(12px, 1.5vw, 20px) clamp(12px, 1.5vw, 20px);
  opacity: 0.3;
  animation: geoPulse 7s ease-in-out infinite 0.5s;
}

/* ── Keyframes ── */
@keyframes geoRotate1 {
  from { transform: rotate(0deg); }
  to   { transform: rotate(360deg); }
}

@keyframes geoRotate2 {
  from { transform: rotate(0deg); }
  to   { transform: rotate(360deg); }
}

@keyframes geoPulse {
  0%, 100% { opacity: 0.15; transform: scaleX(1); }
  50%       { opacity: 0.55; transform: scaleX(1.04); }
}

@keyframes geoCirclePulse {
  0%, 100% { transform: scale(1);    opacity: 0.4; }
  50%       { transform: scale(1.18); opacity: 0.7; }
}

@keyframes geoSlash {
  0%, 100% { opacity: 0.18; }
  50%       { opacity: 0.38; }
}

@keyframes geoFlicker {
  0%, 90%, 100% { opacity: 0.6; }
  92%            { opacity: 0; }
  95%            { opacity: 0.6; }
}

/* ── Hero content ── */
.hero-content {
  position: relative;
  z-index: 2;
  padding: clamp(7rem, 14vh, 11rem) clamp(1.5rem, 6vw, 6rem) clamp(3rem, 6vh, 5rem);
  max-width: 58%;
}

.hero-label {
  display: block;
  font-family: var(--font-mono);
  font-size: clamp(0.6rem, 0.8vw, 0.75rem);
  letter-spacing: 0.3em;
  color: var(--color-muted);
  text-transform: uppercase;
  margin-bottom: clamp(0.75rem, 2vh, 1.25rem);
}

.hero-wordmark {
  font-family: var(--font-display);
  font-weight: 800;
  font-size: clamp(6rem, 18vw, 22rem);
  line-height: 0.85;
  letter-spacing: -0.04em;
  color: var(--color-text);
  margin: 0 0 clamp(1rem, 3vh, 2rem) 0;
  /* Subtle acid bleed on the wordmark */
  text-shadow:
    2px 0 0 #C8FF0008,
    -1px 0 0 #C8FF0004;
}

.hero-tagline {
  font-family: var(--font-body);
  font-weight: 300;
  font-size: clamp(1rem, 1.6vw, 1.5rem);
  line-height: 1.5;
  color: color-mix(in srgb, var(--color-text) 70%, transparent);
  letter-spacing: 0.04em;
  text-transform: uppercase;
  margin: 0 0 clamp(2rem, 4vh, 3rem) 0;
}

.hero-cta {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  font-family: var(--font-mono);
  font-size: 0.7rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--color-accent);
  border: 1px solid var(--color-accent);
  padding: 0.7rem 1.4rem;
  transition: background 0.2s ease, color 0.2s ease;
}

.hero-cta:hover {
  background: var(--color-accent);
  color: #000;
}

/* ── Marquee ticker ── */
.hero-ticker {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 3;
  overflow: hidden;
  border-top: 1px solid color-mix(in srgb, var(--color-accent) 25%, transparent);
  background: color-mix(in srgb, var(--color-bg) 85%, transparent);
  padding: 0.55rem 0;
}

.ticker-track {
  display: flex;
  width: max-content;
  animation: tickerScroll 30s linear infinite;
  will-change: transform;
}

.ticker-track:hover {
  animation-play-state: paused;
}

.ticker-text {
  font-family: var(--font-mono);
  font-size: clamp(0.55rem, 0.75vw, 0.7rem);
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: var(--color-accent);
  padding-right: 1rem;
  white-space: nowrap;
}

@keyframes tickerScroll {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}

/* ─── HIGHLIGHTS ──────────────────────────────────────────── */
.highlights {
  padding: clamp(4rem, 8vw, 7rem) clamp(1.5rem, 6vw, 6rem);
  border-top: 1px solid color-mix(in srgb, var(--color-muted) 25%, transparent);
  content-visibility: auto;
  contain-intrinsic-size: 0 800px;
}

.highlights-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 2px;
}

@media (min-width: 900px) {
  .highlights-grid {
    grid-template-columns: 1.55fr 1fr;
    gap: 2px;
    align-items: start;
  }
}

/* ── Shared card ── */
.card {
  background: var(--color-card);
  padding: clamp(1.5rem, 3vw, 2.5rem);
  position: relative;
  overflow: hidden;
}

.card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg, var(--color-accent), transparent 70%);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.card:hover::before {
  opacity: 1;
}

/* Section label */
.section-label {
  display: block;
  font-family: var(--font-mono);
  font-size: 0.6rem;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--color-muted);
  margin-bottom: 1.25rem;
}

/* ── Blog post card ── */
.card-post {
  grid-row: 1;
  display: flex;
  flex-direction: column;
  gap: 0;
  padding: 0;
  background: var(--color-card);
}

.card-img-wrap {
  position: relative;
  aspect-ratio: 16 / 9;
  overflow: hidden;
  flex-shrink: 0;
}

.card-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  filter: grayscale(30%);
  transition: filter 0.4s ease, transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}

.card-post:hover .card-img {
  filter: grayscale(0%);
  transform: scale(1.03);
}

.card-img-placeholder {
  width: 100%;
  height: 100%;
  background: #0f0f0f;
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-img-placeholder span {
  font-family: var(--font-display);
  font-weight: 800;
  font-size: clamp(3rem, 8vw, 7rem);
  color: color-mix(in srgb, var(--color-muted) 30%, transparent);
  letter-spacing: -0.04em;
  user-select: none;
}

.card-img-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(26,26,26,0.85) 0%, transparent 60%);
}

.card-post .card-body {
  padding: clamp(1.25rem, 2.5vw, 2rem);
}

.card-meta-row {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-bottom: 0.75rem;
  flex-wrap: wrap;
}

.category-pill {
  font-family: var(--font-mono);
  font-size: 0.55rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: #000;
  background: var(--color-accent);
  padding: 0.2rem 0.6rem;
  line-height: 1.6;
}

.card-date {
  font-family: var(--font-mono);
  font-size: 0.6rem;
  letter-spacing: 0.15em;
  color: var(--color-muted);
}

.card-title {
  font-family: var(--font-display);
  font-weight: 800;
  font-size: clamp(1.25rem, 2.5vw, 2rem);
  line-height: 1.1;
  letter-spacing: -0.02em;
  color: var(--color-text);
  margin: 0 0 0.75rem 0;
}

.card-title--event {
  font-size: clamp(1.1rem, 2vw, 1.6rem);
  margin: 0.5rem 0;
}

.card-title--podcast {
  font-size: clamp(0.95rem, 1.5vw, 1.25rem);
  margin: 0.5rem 0;
  line-height: 1.25;
}

.card-desc {
  font-family: var(--font-body);
  font-size: clamp(0.9rem, 1.2vw, 1rem);
  line-height: 1.6;
  color: color-mix(in srgb, var(--color-text) 65%, transparent);
  margin: 0 0 1.25rem 0;
}

.card-desc--sm {
  font-size: clamp(0.8rem, 1vw, 0.9rem);
  -webkit-line-clamp: 3;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-link {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-family: var(--font-mono);
  font-size: 0.65rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--color-accent);
  transition: gap 0.2s ease;
}

.card-link:hover {
  gap: 0.8rem;
  color: var(--color-accent);
}

/* ── Sidebar ── */
.card-sidebar {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

/* ── Event card ── */
.card-event {
  border-left: 3px solid var(--color-accent);
}

.event-date-block {
  display: flex;
  align-items: baseline;
  gap: 0.4rem;
  margin-bottom: 0.5rem;
}

.event-day {
  font-family: var(--font-mono);
  font-size: clamp(3rem, 5vw, 4.5rem);
  font-weight: 700;
  line-height: 1;
  color: var(--color-accent);
  letter-spacing: -0.04em;
}

.event-month {
  font-family: var(--font-mono);
  font-size: clamp(0.7rem, 1vw, 0.9rem);
  letter-spacing: 0.15em;
  color: var(--color-muted);
  text-transform: uppercase;
}

.event-location {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  letter-spacing: 0.1em;
  color: var(--color-muted);
  text-transform: uppercase;
  margin: 0 0 0.75rem 0;
}

.event-links {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  flex-wrap: wrap;
  margin-top: 0.5rem;
}

.btn-ticket {
  font-family: var(--font-mono);
  font-size: 0.6rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: #000;
  background: var(--color-accent);
  padding: 0.35rem 0.8rem;
  transition: background 0.2s ease, color 0.2s ease;
