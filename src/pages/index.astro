---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

// Get content
const allBlogPosts = await getCollection("blog", ({ data }) => !data.draft);
const allEvents = await getCollection("events", ({ data }) => !data.draft);
const allPodcasts = await getCollection("podcasts", ({ data }) => !data.draft);

// Sort and get latest
const latestPost = allBlogPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0];
const latestEvent = allEvents.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0];
const latestPodcast = allPodcasts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0];

// Format date helper
function formatDate(date: Date) {
  return new Intl.DateTimeFormat("pt-BR", { day: "2-digit", month: "2-digit" }).format(date);
}

// Category label map
const categoryLabels: Record<string, string> = {
  "evento-interno": "EVENTO INTERNO",
  "evento-rua": "EVENTO RUA",
  "evento-coletivo": "COLETIVO",
};
---

<BaseLayout
  title="Início"
  description="Obra — Coletivo de música eletrônica do Brasil. Techno, experimental, underground."
>
  <!-- ═══════════════════════════════════════════════════
       HERO
  ══════════════════════════════════════════════════════ -->
  <section class="hero" aria-label="Hero">
    <!-- Morphing blob decoration -->
    <div class="hero-geo" aria-hidden="true">
      <svg class="blob" viewBox="0 0 600 600" xmlns="http://www.w3.org/2000/svg">
        <g transform="translate(300,300)">
          <path d="M120,-157.6C152.7,-141.5,174.3,-102.6,194.8,-58.8C215.3,-14.9,234.6,33.8,228.4,80.8C222.2,127.8,190.4,173.1,148.1,184C105.8,195,52.9,171.5,-2.4,174.8C-57.8,178.2,-115.6,208.4,-137.5,190.9C-159.3,173.3,-145.3,108,-153,56.3C-160.7,4.6,-190.2,-33.4,-178.3,-54.2C-166.4,-75.1,-113.2,-78.8,-76.6,-93.6C-40,-108.3,-20,-134.2,11.9,-150.5C43.7,-166.8,87.4,-173.6,120,-157.6Z"/>
        </g>
      </svg>
      <svg class="blob blob-2" viewBox="0 0 600 600" xmlns="http://www.w3.org/2000/svg">
        <g transform="translate(300,300)">
          <path d="M82,-118C108,-102,124,-76,130,-46C136,-16,128,16,116,44C104,72,86,98,62,116C38,134,10,146,-20,144C-50,142,-80,130,-102,110C-124,90,-138,62,-140,30C-142,0,-132,-28,-114,-54C-96,-80,-72,-100,-44,-112C-16,-124,14,-128,42,-124C70,-120,56,-134,82,-118Z"/>
        </g>
      </svg>
      <svg class="blob blob-3" viewBox="0 0 600 600" xmlns="http://www.w3.org/2000/svg">
        <g transform="translate(300,300)">
          <path d="M142,-100C170,-80,188,-48,192,-12C196,24,188,62,166,94C144,126,106,152,66,164C26,176,-16,172,-56,158C-96,144,-136,120,-158,88C-180,56,-184,14,-174,-24C-164,-62,-140,-94,-108,-118C-76,-142,-40,-158,-2,-162C36,-166,74,-162,106,-148C138,-134,114,-120,142,-100Z"/>
        </g>
      </svg>
    </div>

    <!-- Hero content -->
    <div class="hero-content">
      <span class="hero-label">COLETIVO&nbsp;/&nbsp;BRASIL</span>
      <h1 class="hero-wordmark">
        <img
          src="/images/obra-letters-white.png"
          alt="OBRA"
          width="1354"
          height="322"
          fetchpriority="high"
          draggable="false"
        />
      </h1>
      <p class="hero-tagline">Música eletrônica underground.<br />Techno. House. Experimental. Resistência.</p>
      <a href="/about" class="hero-cta">
        <span>SOBRE O COLETIVO</span>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>

    <!-- Marquee ticker -->
    <div class="hero-ticker" aria-hidden="true">
      <div class="ticker-track">
        {Array.from({ length: 6 }).map(() => (
          <span class="ticker-text">
          MÚSICA ELETRÔNICA&nbsp;&mdash;&nbsp;COLETIVO&nbsp;&mdash;&nbsp;PELOTAS&nbsp;&mdash;&nbsp;UNDERGROUND&nbsp;&mdash;&nbsp;RESISTÊNCIA&nbsp;&mdash;&nbsp;
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       HIGHLIGHTS GRID
  ══════════════════════════════════════════════════════ -->
  <section class="highlights" aria-label="Destaques">
    <div class="highlights-grid">

      <!-- ── LATEST BLOG POST (large card, spans 2 cols) ── -->
      {latestPost && (
        <article class="card card-post reveal">
          <div class="card-img-wrap">
            {latestPost.data.cover ? (
              <img
                src={latestPost.data.cover}
                alt={latestPost.data.title}
                class="card-img"
                fetchpriority="high"
                loading="eager"
                decoding="async"
              />
            ) : (
              <div class="card-img-placeholder" aria-hidden="true">
                <span>OBRA</span>
              </div>
            )}
            <div class="card-img-overlay" aria-hidden="true"></div>
          </div>

          <div class="card-body">
            <span class="section-label">— ÚLTIMA POSTAGEM</span>
            <div class="card-meta-row">
              {latestPost.data.category && (
                <span class="category-pill">
                  {categoryLabels[latestPost.data.category] ?? latestPost.data.category}
                </span>
              )}
              <time class="card-date" datetime={latestPost.data.date.toISOString()}>
                {formatDate(latestPost.data.date)}
              </time>
            </div>
            <h2 class="card-title">{latestPost.data.title}</h2>
            {latestPost.data.description && (
              <p class="card-desc">{latestPost.data.description}</p>
            )}
            <a href={`/blog/${latestPost.slug}`} class="card-link link-underline">
              LER MAIS
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
        </article>
      )}

      <!-- ── SIDEBAR: EVENT + PODCAST ── -->
      <div class="card-sidebar">

        <!-- LATEST EVENT -->
        {latestEvent && (
          <article class="card card-event reveal" style="--reveal-delay: 0.15s">
            <span class="section-label">— PRÓXIMO EVENTO</span>
            <div class="event-date-block">
              <span class="event-day">
                {latestEvent.data.date.toLocaleDateString("pt-BR", { day: "2-digit" })}
              </span>
              <span class="event-month">
                {latestEvent.data.date.toLocaleDateString("pt-BR", { month: "short" }).toUpperCase().replace(".", "")}
              </span>
            </div>
            <h2 class="card-title card-title--event">{latestEvent.data.name}</h2>
            {latestEvent.data.location && (
              <p class="event-location">
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true" style="display:inline;vertical-align:middle;margin-right:4px">
                  <circle cx="6" cy="5" r="2" stroke="currentColor" stroke-width="1.2"/>
                  <path d="M6 1C3.79 1 2 2.79 2 5c0 3 4 7 4 7s4-4 4-7c0-2.21-1.79-4-4-4z" stroke="currentColor" stroke-width="1.2" fill="none"/>
                </svg>
                {latestEvent.data.location}
              </p>
            )}
            {latestEvent.data.description && (
              <p class="card-desc card-desc--sm">{latestEvent.data.description}</p>
            )}
            <div class="event-links">
              <a href={`/events/${latestEvent.slug}`} class="card-link link-underline">VER EVENTO</a>
              {latestEvent.data.ticketUrl && (
                <a href={latestEvent.data.ticketUrl} class="btn-ticket" target="_blank" rel="noopener noreferrer">
                  INGRESSOS →
                </a>
              )}
            </div>
          </article>
        )}

        <!-- LATEST PODCAST -->
        {latestPodcast && (
          <article class="card card-podcast reveal" style="--reveal-delay: 0.3s">
            <span class="section-label">— ÚLTIMO PODCAST</span>
            <div class="podcast-icon" aria-hidden="true">
              <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="24" cy="24" r="22" stroke="currentColor" stroke-width="1.5"/>
                <circle cx="24" cy="24" r="8" fill="currentColor" opacity="0.15"/>
                <circle cx="24" cy="24" r="3" fill="currentColor"/>
                <path d="M10 24a14 14 0 0114-14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M38 24a14 14 0 01-14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M16 24a8 8 0 018-8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M32 24a8 8 0 01-8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </div>
            <h2 class="card-title card-title--podcast">{latestPodcast.data.title}</h2>
            {latestPodcast.data.duration && (
              <span class="podcast-duration">{latestPodcast.data.duration}</span>
            )}
            {latestPodcast.data.description && (
              <p class="card-desc card-desc--sm">{latestPodcast.data.description}</p>
            )}
            <div class="podcast-embed-hint" aria-hidden="true">
              <span class="embed-bar"></span>
              <span class="embed-bar"></span>
              <span class="embed-bar"></span>
              <span class="embed-bar"></span>
              <span class="embed-bar"></span>
              <span class="embed-bar"></span>
              <span class="embed-bar"></span>
              <span class="embed-bar"></span>
              <span class="embed-bar"></span>
            </div>
            <a href={`/podcasts/${latestPodcast.slug}`} class="card-link link-underline">OUVIR AGORA</a>
          </article>
        )}

      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       MANIFESTO
  ══════════════════════════════════════════════════════ -->
  <section class="manifesto reveal" aria-label="Manifesto">
    <div class="manifesto-inner">
      <p class="manifesto-text">
        <span class="manifesto-obra">OBRA</span> é um coletivo de música eletrônica
        nascido nas periferias sonoras de São Paulo.
        Criamos espaços de escuta, resistência e celebração —
        nos largos, nos porões, nos estúdios improvisados.
        O underground não é nicho. É território.
      </p>
      <a href="/about" class="manifesto-link">
        <span>LEIA O MANIFESTO COMPLETO</span>
        <div class="manifesto-line" aria-hidden="true"></div>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
/* ─── HERO ────────────────────────────────────────────────── */
.hero {
  position: relative;
  min-height: 90vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  overflow: hidden;
  margin-top: -4rem; /* overlap header */
  background-color: #080808;
  isolation: isolate;
  contain: layout;
}

/* ── Morphing blob ── */
.hero-geo {
  position: absolute;
  inset: 0;
  pointer-events: none;
  overflow: hidden;
}

.blob {
  position: absolute;
  right: -5%;
  top: 50%;
  transform: translateY(-50%);
  width: clamp(380px, 52vw, 680px);
  height: auto;
  filter: blur(12px);
}

.blob path {
  fill: none;
  stroke: #F0EDE6;
  stroke-width: 2;
  opacity: 0.8;
  transform-box: fill-box;
  transform-origin: center;
  animation: blobMorph 7s linear infinite, blobRot 53s linear infinite;
  will-change: d, transform;
}

@keyframes blobMorph {
  0%   { d: path("M120,-157.6C152.7,-141.5,174.3,-102.6,194.8,-58.8C215.3,-14.9,234.6,33.8,228.4,80.8C222.2,127.8,190.4,173.1,148.1,184C105.8,195,52.9,171.5,-2.4,174.8C-57.8,178.2,-115.6,208.4,-137.5,190.9C-159.3,173.3,-145.3,108,-153,56.3C-160.7,4.6,-190.2,-33.4,-178.3,-54.2C-166.4,-75.1,-113.2,-78.8,-76.6,-93.6C-40,-108.3,-20,-134.2,11.9,-150.5C43.7,-166.8,87.4,-173.6,120,-157.6Z"); }
  25%  { d: path("M67.8,-97.1C87.8,-78.8,103.8,-58.9,117.4,-34.1C130.9,-9.4,142,20.2,139.5,50.7C137,81.2,120.8,112.6,95.3,150.1C69.8,187.7,34.9,231.3,3.3,226.8C-28.2,222.2,-56.4,169.3,-91.6,134.9C-126.8,100.5,-169,84.6,-179.6,57.1C-190.2,29.7,-169.3,-9.3,-155.2,-49.7C-141,-90.1,-133.7,-132,-109,-148.8C-84.2,-165.6,-42.1,-157.3,-9.1,-144.8C23.9,-132.2,47.8,-115.5,67.8,-97.1Z"); }
  50%  { d: path("M137.1,-191.3C172,-163.4,190.6,-115.7,197.2,-70.1C203.8,-24.4,198.5,19.2,178.9,51.5C159.3,83.9,125.5,105,93.3,129.6C61.1,154.1,30.6,182.1,1.1,180.6C-28.4,179.1,-56.8,148.2,-81.2,121.1C-105.6,94.1,-126.1,70.8,-141.6,41.6C-157.2,12.4,-168,-22.9,-153.9,-45C-139.8,-67,-100.7,-76,-70.9,-105.5C-41.1,-135,-20.6,-185,15.3,-206C51.1,-227.1,102.3,-219.1,137.1,-191.3Z"); }
  75%  { d: path("M123.7,-157.1C162.4,-142.2,197.2,-108.8,202.8,-70.8C208.3,-32.9,184.5,9.7,169,54.2C153.6,98.7,146.4,145.2,119.7,162.7C92.9,180.2,46.4,168.6,-1.9,171.1C-50.2,173.7,-100.3,190.4,-122.2,171.3C-144.1,152.3,-137.7,97.5,-144.1,52.7C-150.6,7.9,-169.9,-26.8,-170.5,-64.8C-171,-102.8,-152.8,-144,-121.3,-161.3C-89.7,-178.5,-44.9,-171.8,-1.2,-170.1C42.5,-168.5,85,-172,123.7,-157.1Z"); }
  100% { d: path("M120,-157.6C152.7,-141.5,174.3,-102.6,194.8,-58.8C215.3,-14.9,234.6,33.8,228.4,80.8C222.2,127.8,190.4,173.1,148.1,184C105.8,195,52.9,171.5,-2.4,174.8C-57.8,178.2,-115.6,208.4,-137.5,190.9C-159.3,173.3,-145.3,108,-153,56.3C-160.7,4.6,-190.2,-33.4,-178.3,-54.2C-166.4,-75.1,-113.2,-78.8,-76.6,-93.6C-40,-108.3,-20,-134.2,11.9,-150.5C43.7,-166.8,87.4,-173.6,120,-157.6Z"); }
}

@keyframes blobRot {
  from { transform: rotate(0deg);   }
  to   { transform: rotate(360deg); }
}

/* ── Blob 2 — smaller, upper area, offset left ── */
.blob-2 {
  right: 20%;
  top: 3%;
  transform: none;
  width: clamp(220px, 30vw, 400px);
}

.blob-2 path {
  opacity: 0.8;
  animation: blobMorph2 9s linear infinite, blobRot 40s linear infinite;
}

@keyframes blobMorph2 {
  0%   { d: path("M82,-118C108,-102,124,-76,130,-46C136,-16,128,16,116,44C104,72,86,98,62,116C38,134,10,146,-20,144C-50,142,-80,130,-102,110C-124,90,-138,62,-140,30C-142,0,-132,-28,-114,-54C-96,-80,-72,-100,-44,-112C-16,-124,14,-128,42,-124C70,-120,56,-134,82,-118Z"); }
  25%  { d: path("M46,-68C60,-52,74,-32,84,-8C94,16,98,44,92,72C86,100,70,126,50,150C30,174,6,196,-20,192C-46,188,-72,158,-94,130C-116,102,-134,74,-140,44C-146,14,-142,-18,-130,-44C-118,-70,-96,-90,-70,-100C-44,-110,-16,-112,12,-108C40,-104,32,-84,46,-68Z"); }
  50%  { d: path("M96,-126C124,-110,140,-80,146,-46C152,-12,146,24,134,56C122,88,104,114,80,132C56,150,28,160,-2,158C-32,156,-62,144,-88,124C-114,104,-130,76,-136,46C-142,16,-136,-16,-122,-44C-108,-72,-84,-96,-56,-110C-28,-124,2,-128,32,-126C62,-124,68,-142,96,-126Z"); }
  75%  { d: path("M72,-130C98,-116,116,-90,124,-60C132,-30,130,2,120,32C110,62,92,90,68,110C44,130,14,142,-18,138C-50,134,-82,120,-108,96C-134,72,-154,38,-158,2C-162,-34,-152,-72,-130,-98C-108,-124,-76,-138,-42,-144C-8,-150,26,-146,58,-138C90,-130,46,-144,72,-130Z"); }
  100% { d: path("M82,-118C108,-102,124,-76,130,-46C136,-16,128,16,116,44C104,72,86,98,62,116C38,134,10,146,-20,144C-50,142,-80,130,-102,110C-124,90,-138,62,-140,30C-142,0,-132,-28,-114,-54C-96,-80,-72,-100,-44,-112C-16,-124,14,-128,42,-124C70,-120,56,-134,82,-118Z"); }
}

/* ── Blob 3 — medium, upper-right, partially clipped ── */
.blob-3 {
  right: -8%;
  top: -10%;
  transform: none;
  width: clamp(270px, 37vw, 490px);
}

.blob-3 path {
  opacity: 0.8;
  animation: blobMorph3 11s linear infinite, blobRotCCW 68s linear infinite;
}

@keyframes blobMorph3 {
  0%   { d: path("M142,-100C170,-80,188,-48,192,-12C196,24,188,62,166,94C144,126,106,152,66,164C26,176,-16,172,-56,158C-96,144,-136,120,-158,88C-180,56,-184,14,-174,-24C-164,-62,-140,-94,-108,-118C-76,-142,-40,-158,-2,-162C36,-166,74,-162,106,-148C138,-134,114,-120,142,-100Z"); }
  25%  { d: path("M94,-126C124,-108,144,-76,154,-40C164,-4,162,36,148,72C134,108,106,138,74,162C42,186,6,202,-32,196C-70,190,-106,162,-136,128C-166,94,-188,54,-190,12C-192,-30,-176,-74,-148,-106C-120,-138,-82,-158,-42,-168C-2,-178,40,-170,80,-158C120,-146,64,-144,94,-126Z"); }
  50%  { d: path("M152,-110C178,-90,192,-58,196,-22C200,14,192,52,174,84C156,116,126,142,92,158C58,174,20,180,-20,176C-60,172,-100,158,-132,134C-164,110,-186,76,-192,38C-198,0,-188,-40,-164,-72C-140,-104,-104,-128,-64,-144C-24,-160,18,-168,60,-164C102,-160,126,-130,152,-110Z"); }
  75%  { d: path("M128,-124C156,-106,174,-76,180,-42C186,-8,180,30,162,62C144,94,116,120,84,140C52,160,16,174,-22,170C-60,166,-98,144,-128,116C-158,88,-178,52,-182,14C-186,-24,-172,-64,-148,-96C-124,-128,-90,-150,-52,-158C-14,-166,26,-160,64,-150C102,-140,100,-142,128,-124Z"); }
  100% { d: path("M142,-100C170,-80,188,-48,192,-12C196,24,188,62,166,94C144,126,106,152,66,164C26,176,-16,172,-56,158C-96,144,-136,120,-158,88C-180,56,-184,14,-174,-24C-164,-62,-140,-94,-108,-118C-76,-142,-40,-158,-2,-162C36,-166,74,-162,106,-148C138,-134,114,-120,142,-100Z"); }
}

@keyframes blobRotCCW {
  from { transform: rotate(0deg);    }
  to   { transform: rotate(-360deg); }
}

@media (prefers-reduced-motion: reduce) {
  .blob path { animation: none; }
}

/* ── Hero content ── */
.hero-content {
  position: relative;
  z-index: 2;
  padding: clamp(7rem, 14vh, 11rem) clamp(1.5rem, 6vw, 6rem) clamp(3rem, 6vh, 5rem);
  max-width: 58%;
}

.hero-label {
  display: block;
  font-family: var(--font-mono);
  font-size: clamp(0.6rem, 0.8vw, 0.75rem);
  letter-spacing: 0.3em;
  color: var(--color-muted);
  text-transform: uppercase;
  margin-bottom: clamp(0.75rem, 2vh, 1.25rem);
}

.hero-wordmark {
  margin: 0 0 clamp(1rem, 3vh, 2rem) 0;
}

.hero-wordmark img {
  display: block;
  width: clamp(16rem, 72vw, 80rem);
  height: auto;
  /* Preserve the subtle acid bleed effect */
  filter: drop-shadow(2px 0 0 #C8FF0008) drop-shadow(-1px 0 0 #C8FF0004);
}

.hero-tagline {
  font-family: var(--font-body);
  font-weight: 300;
  font-size: clamp(1rem, 1.6vw, 1.5rem);
  line-height: 1.5;
  color: color-mix(in srgb, var(--color-text) 70%, transparent);
  letter-spacing: 0.04em;
  text-transform: uppercase;
  margin: 0 0 clamp(2rem, 4vh, 3rem) 0;
}

.hero-cta {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  font-family: var(--font-mono);
  font-size: 0.7rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--color-accent);
  border: 1px solid var(--color-accent);
  padding: 0.7rem 1.4rem;
  transition: background 0.2s ease, color 0.2s ease;
}

.hero-cta:hover {
  background: var(--color-accent);
  color: #000;
}

/* ── Marquee ticker ── */
.hero-ticker {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 3;
  overflow: hidden;
  border-top: 1px solid color-mix(in srgb, var(--color-accent) 25%, transparent);
  background: color-mix(in srgb, var(--color-bg) 85%, transparent);
  padding: 0.55rem 0;
}

.ticker-track {
  display: flex;
  width: max-content;
  animation: tickerScroll 30s linear infinite;
  will-change: transform;
}

.ticker-track:hover {
  animation-play-state: paused;
}

.ticker-text {
  font-family: var(--font-mono);
  font-size: clamp(0.55rem, 0.75vw, 0.7rem);
