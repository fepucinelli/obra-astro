---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DateFilter from "../../components/DateFilter.vue";
import { getAllEvents } from "../../lib/payload";

const allEvents = await getAllEvents();
const now = new Date();

const upcoming = allEvents.filter((e) => e.date > now);
const past = allEvents.filter((e) => e.date <= now);

const events = [...upcoming, ...past].map((e) => ({
  slug: e.slug,
  name: e.name,
  date: e.date.toISOString(),
  image: e.image,
  location: e.location,
  description: e.description,
}));
---

<BaseLayout
  title="Eventos"
  description="Todos os eventos do coletivo Obra — festas, ocupações e soundsystems."
>
  <!-- Page hero -->
  <section class="px-6 md:px-12 pt-16 pb-12 border-b border-obra-muted/30 overflow-hidden relative">
    <!-- Background label -->
    <div
      class="absolute right-0 top-1/2 -translate-y-1/2 font-mono font-bold text-obra-card select-none pointer-events-none leading-none"
      style="font-size: clamp(6rem, 18vw, 16rem); letter-spacing: -0.04em;"
      aria-hidden="true"
    >
      EVENTOS
    </div>

    <div class="relative z-10 max-w-5xl">
      <p class="font-mono text-xs tracking-widest text-obra-muted uppercase mb-6">
        OBRA / AGENDA
      </p>
      <h1
        class="font-mono font-bold text-obra-white leading-none mb-6"
        style="font-size: clamp(3.5rem, 10vw, 8rem); letter-spacing: -0.03em;"
      >
        EVENTOS
      </h1>
      <p class="font-body text-obra-muted text-lg max-w-lg leading-relaxed">
        Festas fechadas, ocupações na rua e soundsystems. Toda a agenda do coletivo Obra.
      </p>

      <!-- Stats -->
      <div class="flex gap-8 mt-10">
        <div>
          <p class="font-mono text-obra-accent text-2xl font-bold">{upcoming.length}</p>
          <p class="font-mono text-xs text-obra-muted tracking-widest uppercase mt-1">Próximos</p>
        </div>
        <div class="w-px bg-obra-muted/30"></div>
        <div>
          <p class="font-mono text-obra-white text-2xl font-bold">{past.length}</p>
          <p class="font-mono text-xs text-obra-muted tracking-widest uppercase mt-1">Realizados</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Events with filter -->
  <section class="px-6 md:px-12 py-16 max-w-5xl">
    <DateFilter events={events} client:visible />
  </section>
</BaseLayout>
