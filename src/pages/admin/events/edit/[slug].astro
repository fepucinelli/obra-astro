---
export const prerender = false;
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import AdminForm from "../../../../components/AdminForm.vue";
import { getEntry } from "astro:content";

const { slug } = Astro.params;
const event = await getEntry("events", slug!);

if (!event) {
  return Astro.redirect("/admin/events");
}

const initialData = {
  name: event.data.name,
  description: event.data.description || "",
  date: event.data.date.toISOString().split("T")[0],
  location: event.data.location || "",
  image: event.data.image || "",
  ticketUrl: event.data.ticketUrl || "",
  draft: event.data.draft,
  body: "",
};
---

<AdminLayout title={`Editar: ${event.data.name}`} section="events">
  <div style="margin-bottom: 1.5rem; display: flex; align-items: center; justify-content: space-between;">
    <a
      href="/admin/events"
      class="font-mono"
      style="font-size: 0.65rem; letter-spacing: 0.15em; text-transform: uppercase; color: #444444; text-decoration: none;"
      onmouseover="this.style.color='#C8FF00'"
      onmouseout="this.style.color='#444444'"
    >
      ← Eventos
    </a>
    <a
      href={`/events/${event.slug}`}
      target="_blank"
      rel="noopener noreferrer"
      class="font-mono"
      style="font-size: 0.65rem; letter-spacing: 0.15em; text-transform: uppercase; color: #444444; text-decoration: none;"
      onmouseover="this.style.color='#C8FF00'"
      onmouseout="this.style.color='#444444'"
    >
      Ver evento ↗
    </a>
  </div>

  <AdminForm
    client:load
    contentType="events"
    slug={event.slug}
    initialData={initialData}
  />
</AdminLayout>
