---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { getCollection } from "astro:content";

const allEvents = await getCollection("events");
const events = allEvents.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<AdminLayout title="Eventos" section="events">
  <!-- Top bar -->
  <div
    style="
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 2rem;
    "
  >
    <p
      class="font-mono"
      style="font-size: 0.65rem; letter-spacing: 0.2em; color: #444444; text-transform: uppercase;"
    >
      {events.length} {events.length === 1 ? "EVENTO" : "EVENTOS"}
    </p>
    <a
      href="/admin/events/new"
      class="font-mono new-btn"
      style="
        font-size: 0.7rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: #080808;
        background-color: #C8FF00;
        padding: 0.6rem 1.25rem;
        font-weight: 700;
        text-decoration: none;
        transition: background-color 0.15s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
      "
    >
      <span aria-hidden="true">+</span>
      Novo Evento
    </a>
  </div>

  <!-- Table -->
  <div
    style="
      border: 1px solid color-mix(in srgb, #444444 30%, transparent);
      overflow: hidden;
    "
  >
    <!-- Header -->
    <div
      style="
        display: grid;
        grid-template-columns: 1fr 10rem 8rem 6rem 5.5rem 4rem;
        gap: 0;
        background-color: color-mix(in srgb, #444444 10%, transparent);
        padding: 0.75rem 1.25rem;
        border-bottom: 1px solid color-mix(in srgb, #444444 30%, transparent);
      "
    >
      {
        ["Nome", "Local", "Data", "Ingressos", "Status", ""].map((col) => (
          <span
            class="font-mono"
            style="font-size: 0.6rem; letter-spacing: 0.15em; color: #444444; text-transform: uppercase;"
          >
            {col}
          </span>
        ))
      }
    </div>

    <!-- Rows -->
    {
      events.map((event, i) => (
        <div
          class="table-row"
          style={`
            display: grid;
            grid-template-columns: 1fr 10rem 8rem 6rem 5.5rem 4rem;
            gap: 0;
            padding: 1rem 1.25rem;
            align-items: center;
            ${i < events.length - 1 ? "border-bottom: 1px solid color-mix(in srgb, #444444 20%, transparent);" : ""}
            transition: background-color 0.15s ease;
          `}
        >
          <!-- Name -->
          <div style="padding-right: 1rem; overflow: hidden;">
            <a
              href={`/admin/events/edit/${event.slug}`}
              class="font-body row-title"
              style="
                font-size: 0.95rem;
                color: #F0EDE6;
                display: block;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
                transition: color 0.15s ease;
                text-decoration: none;
              "
              title={event.data.name}
            >
              {event.data.name}
            </a>
            {event.data.description && (
              <p
                class="font-body"
                style="font-size: 0.8rem; color: #444444; margin-top: 0.15rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"
                title={event.data.description}
              >
                {event.data.description}
              </p>
            )}
          </div>

          <!-- Location -->
          <span
            class="font-body"
            style="font-size: 0.85rem; color: #444444; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding-right: 0.5rem;"
            title={event.data.location}
          >
            {event.data.location ?? "—"}
          </span>

          <!-- Date -->
          <span
            class="font-mono"
            style="font-size: 0.7rem; letter-spacing: 0.05em; color: #444444;"
          >
            {event.data.date.toLocaleDateString("pt-BR", { day: "2-digit", month: "short", year: "numeric" })}
          </span>

          <!-- Ticket URL -->
          <span>
            {event.data.ticketUrl ? (
              <a
                href={event.data.ticketUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="font-mono"
                style="font-size: 0.6rem; letter-spacing: 0.1em; text-transform: uppercase; color: #C8FF00; text-decoration: none;"
              >
                Link ↗
              </a>
            ) : (
              <span class="font-mono" style="font-size: 0.6rem; color: color-mix(in srgb, #444444 50%, transparent);">—</span>
            )}
          </span>

          <!-- Draft status -->
          <span>
            <span
              class="font-mono"
              style={`
                font-size: 0.6rem;
                letter-spacing: 0.15em;
                text-transform: uppercase;
                color: ${event.data.draft ? "#FF6B35" : "#C8FF00"};
              `}
            >
              {event.data.draft ? "Rascunho" : "Público"}
            </span>
          </span>

          <!-- Actions -->
          <div style="display: flex; align-items: center;">
            <a
              href={`/admin/events/edit/${event.slug}`}
              class="font-mono action-link"
              style="font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; color: #444444; text-decoration: none; transition: color 0.15s ease;"
            >
              Editar
            </a>
          </div>
        </div>
      ))
    }

    {
      events.length === 0 && (
        <div style="padding: 3rem 1.25rem; text-align: center;">
          <p class="font-mono" style="font-size: 0.75rem; color: #444444; letter-spacing: 0.1em; margin-bottom: 1rem;">
            Nenhum evento ainda.
          </p>
          <a
            href="/admin/events/new"
            class="font-mono"
            style="font-size: 0.7rem; letter-spacing: 0.15em; color: #C8FF00; text-transform: uppercase; text-decoration: none;"
          >
            Criar o primeiro evento →
          </a>
        </div>
      )
    }
  </div>
</AdminLayout>

<style>
  .new-btn:hover {
    background-color: #F0EDE6 !important;
  }

  .table-row:hover {
    background-color: color-mix(in srgb, #444444 8%, transparent) !important;
  }

  .table-row:hover .row-title {
    color: #C8FF00 !important;
  }

  .action-link:hover {
    color: #C8FF00 !important;
  }
</style>
