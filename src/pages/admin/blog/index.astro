---
export const prerender = false;
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog");
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const categoryLabels: Record<string, string> = {
  "evento-interno": "Interno",
  "evento-rua": "Rua",
  "evento-coletivo": "Coletivo",
};
---

<AdminLayout title="Blog" section="blog">
  <!-- Top bar -->
  <div
    style="
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 2rem;
    "
  >
    <p
      class="font-mono"
      style="font-size: 0.65rem; letter-spacing: 0.2em; color: #444444; text-transform: uppercase;"
    >
      {posts.length} {posts.length === 1 ? "POSTAGEM" : "POSTAGENS"}
    </p>
    <a
      href="/admin/blog/new"
      class="font-mono new-btn"
      style="
        font-size: 0.7rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: #080808;
        background-color: #C8FF00;
        padding: 0.6rem 1.25rem;
        font-weight: 700;
        text-decoration: none;
        transition: background-color 0.15s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
      "
    >
      <span aria-hidden="true">+</span>
      Nova Postagem
    </a>
  </div>

  <!-- Table -->
  <div
    style="
      border: 1px solid color-mix(in srgb, #444444 30%, transparent);
      overflow: hidden;
    "
  >
    <!-- Header -->
    <div
      style="
        display: grid;
        grid-template-columns: 1fr 7rem 8rem 5.5rem 7rem 4rem;
        gap: 0;
        background-color: color-mix(in srgb, #444444 10%, transparent);
        padding: 0.75rem 1.25rem;
        border-bottom: 1px solid color-mix(in srgb, #444444 30%, transparent);
      "
    >
      {
        ["Título", "Categoria", "Data", "Status", "Tags", ""].map((col) => (
          <span
            class="font-mono"
            style="font-size: 0.6rem; letter-spacing: 0.15em; color: #444444; text-transform: uppercase;"
          >
            {col}
          </span>
        ))
      }
    </div>

    <!-- Rows -->
    {
      posts.map((post, i) => (
        <div
          class="table-row"
          style={`
            display: grid;
            grid-template-columns: 1fr 7rem 8rem 5.5rem 7rem 4rem;
            gap: 0;
            padding: 1rem 1.25rem;
            align-items: center;
            ${i < posts.length - 1 ? "border-bottom: 1px solid color-mix(in srgb, #444444 20%, transparent);" : ""}
            transition: background-color 0.15s ease;
          `}
        >
          <!-- Title -->
          <div style="padding-right: 1rem; overflow: hidden;">
            <a
              href={`/admin/blog/edit/${post.slug}`}
              class="font-body row-title"
              style="
                font-size: 0.95rem;
                color: #F0EDE6;
                display: block;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
                transition: color 0.15s ease;
                text-decoration: none;
              "
              title={post.data.title}
            >
              {post.data.title}
            </a>
            {post.data.description && (
              <p
                class="font-body"
                style="font-size: 0.8rem; color: #444444; margin-top: 0.15rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"
                title={post.data.description}
              >
                {post.data.description}
              </p>
            )}
          </div>

          <!-- Category -->
          <span>
            <span
              class="font-mono"
              style="
                font-size: 0.6rem;
                letter-spacing: 0.1em;
                text-transform: uppercase;
                color: #444444;
                border: 1px solid color-mix(in srgb, #444444 40%, transparent);
                padding: 0.2rem 0.4rem;
              "
            >
              {categoryLabels[post.data.category] ?? post.data.category}
            </span>
          </span>

          <!-- Date -->
          <span
            class="font-mono"
            style="font-size: 0.7rem; letter-spacing: 0.05em; color: #444444;"
          >
            {post.data.date.toLocaleDateString("pt-BR", { day: "2-digit", month: "short", year: "numeric" })}
          </span>

          <!-- Draft status -->
          <span>
            <span
              class="font-mono"
              style={`
                font-size: 0.6rem;
                letter-spacing: 0.15em;
                text-transform: uppercase;
                color: ${post.data.draft ? "#FF6B35" : "#C8FF00"};
              `}
            >
              {post.data.draft ? "Rascunho" : "Público"}
            </span>
          </span>

          <!-- Tags -->
          <span
            class="font-body"
            style="font-size: 0.8rem; color: #444444; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"
            title={post.data.tags.join(", ")}
          >
            {post.data.tags.slice(0, 2).join(", ")}
            {post.data.tags.length > 2 && ` +${post.data.tags.length - 2}`}
          </span>

          <!-- Actions -->
          <div style="display: flex; align-items: center; gap: 0.75rem;">
            <a
              href={`/admin/blog/edit/${post.slug}`}
              class="font-mono action-link"
              style="font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; color: #444444; text-decoration: none; transition: color 0.15s ease;"
            >
              Editar
            </a>
          </div>
        </div>
      ))
    }

    {
      posts.length === 0 && (
        <div style="padding: 3rem 1.25rem; text-align: center;">
          <p class="font-mono" style="font-size: 0.75rem; color: #444444; letter-spacing: 0.1em; margin-bottom: 1rem;">
            Nenhuma postagem ainda.
          </p>
          <a
            href="/admin/blog/new"
            class="font-mono"
            style="font-size: 0.7rem; letter-spacing: 0.15em; color: #C8FF00; text-transform: uppercase; text-decoration: none;"
          >
            Criar a primeira postagem →
          </a>
        </div>
      )
    }
  </div>
</AdminLayout>

<style>
  .new-btn:hover {
    background-color: #F0EDE6 !important;
  }

  .table-row:hover {
    background-color: color-mix(in srgb, #444444 8%, transparent) !important;
  }

  .table-row:hover .row-title {
    color: #C8FF00 !important;
  }

  .action-link:hover {
    color: #C8FF00 !important;
  }
</style>
