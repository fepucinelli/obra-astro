---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import EmbedPlayer from "../../components/EmbedPlayer.vue";

export const prerender = true;

const allPodcasts = await getCollection("podcasts", ({ data }) => !data.draft);
const podcasts = allPodcasts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const [featured, ...rest] = podcasts;

function formatDate(d: Date) {
  return d.toLocaleDateString("pt-BR", { day: "2-digit", month: "long", year: "numeric" });
}

function episodeNumber(index: number) {
  return String(podcasts.length - index).padStart(2, "0");
}
---

<BaseLayout
  title="Podcasts"
  description="Frequência — o podcast do coletivo Obra. Mixes, entrevistas e explorações sonoras."
>
  <!-- Page hero -->
  <section class="px-6 md:px-12 pt-16 pb-12 border-b border-obra-muted/30 overflow-hidden relative">
    <!-- Background watermark -->
    <div
      class="absolute right-0 top-1/2 -translate-y-1/2 font-mono font-bold text-obra-card select-none pointer-events-none leading-none"
      style="font-size: clamp(4rem, 12vw, 11rem); letter-spacing: -0.04em;"
      aria-hidden="true"
    >
      FREQUÊNCIA
    </div>

    <div class="relative z-10 max-w-5xl">
      <p class="font-mono text-xs tracking-widest text-obra-muted uppercase mb-6">
        OBRA / AUDIO
      </p>
      <h1
        class="font-mono font-bold text-obra-white leading-none mb-4"
        style="font-size: clamp(2.5rem, 8vw, 6.5rem); letter-spacing: -0.03em;"
      >
        PODCASTS /<br class="hidden md:block" /> FREQUÊNCIA
      </h1>
      <p class="font-body text-obra-muted text-lg max-w-xl leading-relaxed mt-4">
        Mixes, explorações sonoras e documentos de cultura eletrônica. Novos episódios, novas frequências.
      </p>

      <div class="flex gap-8 mt-10">
        <div>
          <p class="font-mono text-obra-accent text-2xl font-bold">{podcasts.length}</p>
          <p class="font-mono text-xs text-obra-muted tracking-widest uppercase mt-1">Episódios</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured episode -->
  {featured && (
    <section class="px-6 md:px-12 py-16 border-b border-obra-muted/30">
      <div class="max-w-5xl">
        <p class="font-mono text-xs tracking-widest text-obra-accent uppercase mb-8">
          — ÚLTIMO EPISÓDIO
        </p>

        <div class="grid md:grid-cols-2 gap-12 items-start">
          <!-- Player -->
          <div class="order-2 md:order-1">
            <div class="border border-obra-muted/30 overflow-hidden">
              <EmbedPlayer
                url={featured.data.embedUrl}
                title={featured.data.title}
                client:visible
              />
            </div>
          </div>

          <!-- Info -->
          <div class="order-1 md:order-2">
            <div class="flex items-center gap-3 mb-4">
              <span class="font-mono text-obra-accent text-sm font-bold tracking-widest">
                EP. {episodeNumber(0)}
              </span>
              <span class="w-8 h-px bg-obra-muted/50"></span>
              {featured.data.duration && (
                <span class="font-mono text-obra-muted text-xs tracking-widest">
                  {featured.data.duration}
                </span>
              )}
            </div>

            <h2
              class="font-display font-bold text-obra-white leading-tight mb-4"
              style="font-size: clamp(1.5rem, 3.5vw, 2.75rem);"
            >
              {featured.data.title}
            </h2>

            <p class="font-mono text-xs text-obra-muted tracking-widest uppercase mb-6">
              {formatDate(featured.data.date)}
            </p>

            {featured.data.description && (
              <p class="font-body text-obra-muted text-base leading-relaxed mb-6">
                {featured.data.description}
              </p>
            )}

            {featured.data.tags.length > 0 && (
              <div class="flex flex-wrap gap-2 mb-8">
                {featured.data.tags.map((tag) => (
                  <span class="font-mono text-xs tracking-widest uppercase px-2 py-1 border border-obra-muted/40 text-obra-muted">
                    {tag}
                  </span>
                ))}
              </div>
            )}

            <a
              href={`/podcasts/${featured.slug}`}
              class="inline-flex items-center gap-3 font-mono text-xs tracking-widest uppercase text-obra-accent border border-obra-accent px-5 py-2.5 hover:bg-obra-accent hover:text-obra-black transition-colors"
            >
              VER EPISÓDIO →
            </a>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- All episodes -->
  <section class="px-6 md:px-12 py-16">
    <div class="max-w-5xl">
      <p class="font-mono text-xs tracking-widest text-obra-muted uppercase mb-10 pb-4 border-b border-obra-muted/30">
        TODOS OS EPISÓDIOS — {podcasts.length}
      </p>

      <div class="flex flex-col gap-0">
        {podcasts.map((podcast, index) => (
          <a
            href={`/podcasts/${podcast.slug}`}
            class="group grid grid-cols-[3rem_1fr] md:grid-cols-[4rem_1fr_auto] gap-4 md:gap-8 py-6 border-b border-obra-muted/20 hover:bg-obra-accent/[0.03] transition-colors items-start"
          >
            <!-- Episode number -->
            <div class="font-mono text-obra-muted text-sm font-bold pt-0.5">
              {episodeNumber(index)}
            </div>

            <!-- Details -->
            <div>
              <h3
                class="font-display font-bold text-obra-white group-hover:text-obra-accent transition-colors leading-snug mb-1"
                style="font-size: clamp(1rem, 2vw, 1.35rem);"
              >
                {podcast.data.title}
              </h3>
              <p class="font-mono text-xs text-obra-muted tracking-widest uppercase mb-2">
                {formatDate(podcast.data.date)}
                {podcast.data.duration && (
                  <span class="ml-3 opacity-70">{podcast.data.duration}</span>
                )}
              </p>
              {podcast.data.description && (
                <p class="font-body text-obra-muted text-sm leading-relaxed line-clamp-2 max-w-xl">
                  {podcast.data.description}
                </p>
              )}
              {podcast.data.tags.length > 0 && (
                <div class="flex flex-wrap gap-1.5 mt-3">
                  {podcast.data.tags.map((tag) => (
                    <span class="font-mono text-xs tracking-widest uppercase px-2 py-0.5 border border-obra-muted/30 text-obra-muted/60">
                      {tag}
                    </span>
                  ))}
                </div>
              )}
            </div>

            <!-- Arrow (desktop) -->
            <div class="hidden md:flex items-center pt-1">
              <span class="font-mono text-obra-muted group-hover:text-obra-accent transition-colors text-sm">
                →
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
