---
import BaseLayout from "../layouts/BaseLayout.astro";

export const prerender = true;

const pressAssets = [
  { name: "Logo OBRA (PNG)", file: "/press/obra-logo.png", type: "PNG", size: "2.1 MB" },
  { name: "Logo OBRA (SVG)", file: "/press/obra-logo.svg", type: "SVG", size: "48 KB" },
  { name: "Logo OBRA (Fundo Branco)", file: "/press/obra-logo-white.png", type: "PNG", size: "1.8 MB" },
  { name: "Press Release 2024", file: "/press/obra-press-release-2024.pdf", type: "PDF", size: "340 KB" },
  { name: "Fotos do Coletivo", file: "/press/obra-fotos.zip", type: "ZIP", size: "45 MB" },
  { name: "Rider Técnico", file: "/press/obra-rider-tecnico.pdf", type: "PDF", size: "210 KB" },
];

const typeColors: Record<string, string> = {
  PNG: "#C8FF00",
  SVG: "#C8FF00",
  PDF: "#FF6B35",
  ZIP: "#888888",
};
---

<BaseLayout
  title="Press Kit"
  description="Materiais de imprensa, assets e informações de contato para jornalistas e parceiros."
>
  <!-- Header -->
  <section
    style="
      border-bottom: 1px solid color-mix(in srgb, #444444 30%, transparent);
      padding: 5rem 3rem 0;
      overflow: hidden;
    "
  >
    <div style="max-width: 1400px; margin: 0 auto;">
      <!-- Section label -->
      <p
        class="font-mono reveal"
        style="
          font-size: 0.7rem;
          letter-spacing: 0.25em;
          color: #444444;
          text-transform: uppercase;
          margin-bottom: 3rem;
        "
      >
        — IMPRENSA
      </p>

      <!-- Giant heading -->
      <h1
        class="font-display reveal"
        style="
          font-size: clamp(4rem, 15vw, 12rem);
          font-weight: 800;
          line-height: 0.88;
          letter-spacing: -0.03em;
          color: #F0EDE6;
          margin: 0;
          text-transform: uppercase;
        "
      >
        PRESS<br /><span style="color: #C8FF00;">KIT</span>
      </h1>

      <!-- Divider strip -->
      <div
        class="reveal"
        style="
          display: flex;
          align-items: center;
          gap: 2rem;
          padding: 1.5rem 0;
          margin-top: 2rem;
          border-top: 1px solid color-mix(in srgb, #444444 30%, transparent);
        "
      >
        <span
          class="font-mono"
          style="font-size: 0.65rem; letter-spacing: 0.2em; color: #444444; text-transform: uppercase;"
        >
          {pressAssets.length} ARQUIVOS DISPONÍVEIS
        </span>
        <span style="height: 1px; flex: 1; background-color: color-mix(in srgb, #444444 20%, transparent);"></span>
        <span
          class="font-mono"
          style="font-size: 0.65rem; letter-spacing: 0.2em; color: #C8FF00; text-transform: uppercase;"
        >
          ATUALIZADO 2024
        </span>
      </div>
    </div>
  </section>

  <!-- Description -->
  <section
    style="
      padding: 5rem 3rem;
      border-bottom: 1px solid color-mix(in srgb, #444444 30%, transparent);
    "
  >
    <div
      style="
        max-width: 1400px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6rem;
        align-items: start;
      "
    >
      <div class="reveal">
        <p
          class="font-body"
          style="
            font-size: 1.4rem;
            font-weight: 500;
            line-height: 1.5;
            color: #F0EDE6;
            margin-bottom: 1.5rem;
          "
        >
          Este kit contém todos os materiais necessários para cobertura jornalística, parcerias editoriais e uso em mídias autorizadas.
        </p>
        <p
          class="font-body"
          style="
            font-size: 1.1rem;
            line-height: 1.65;
            color: color-mix(in srgb, #F0EDE6 60%, transparent);
          "
        >
          Para solicitações específicas — entrevistas, imagens exclusivas, credenciais para eventos — entre em contato com nossa equipe de comunicação antes do uso.
        </p>
      </div>
      <div class="reveal" style="padding-top: 0.5rem;">
        <div
          style="
            background-color: #1A1A1A;
            border: 1px solid color-mix(in srgb, #444444 40%, transparent);
            padding: 2rem 2.5rem;
          "
        >
          <p
            class="font-mono"
            style="font-size: 0.65rem; letter-spacing: 0.2em; color: #C8FF00; text-transform: uppercase; margin-bottom: 1.25rem;"
          >
            CONTATO DE IMPRENSA
          </p>
          <p
            class="font-display"
            style="font-size: 1.5rem; font-weight: 700; color: #F0EDE6; margin-bottom: 0.5rem;"
          >
            press@obra.xyz
          </p>
          <p
            class="font-body"
            style="font-size: 0.95rem; color: #444444; margin-bottom: 2rem;"
          >
            Resposta em até 48 horas úteis
          </p>
          <div
            style="height: 1px; background-color: color-mix(in srgb, #444444 30%, transparent); margin-bottom: 1.5rem;"
          ></div>
          <p
            class="font-mono"
            style="font-size: 0.65rem; letter-spacing: 0.2em; color: #C8FF00; text-transform: uppercase; margin-bottom: 1rem;"
          >
            BOOKING
          </p>
          <p
            class="font-display"
            style="font-size: 1.3rem; font-weight: 700; color: #F0EDE6;"
          >
            booking@obra.xyz
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Download grid -->
  <section
    style="
      padding: 5rem 3rem;
      border-bottom: 1px solid color-mix(in srgb, #444444 30%, transparent);
    "
  >
    <div style="max-width: 1400px; margin: 0 auto;">
      <p
        class="font-mono reveal"
        style="
          font-size: 0.7rem;
          letter-spacing: 0.25em;
          color: #444444;
          text-transform: uppercase;
          margin-bottom: 3rem;
        "
      >
        — ARQUIVOS
      </p>

      <div
        class="reveal"
        style="
          display: grid;
          grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
          gap: 1px;
          background-color: color-mix(in srgb, #444444 20%, transparent);
        "
      >
        {
          pressAssets.map((asset) => (
            <div
              class="press-card"
              style="
                background-color: #080808;
                padding: 2rem 2rem 2rem;
                display: flex;
                flex-direction: column;
                gap: 1rem;
                transition: background-color 0.2s ease;
              "
            >
              <!-- Type badge -->
              <div style="display: flex; align-items: center; justify-content: space-between;">
                <span
                  class="font-mono"
                  style={`
                    font-size: 0.6rem;
                    letter-spacing: 0.2em;
                    font-weight: 700;
                    text-transform: uppercase;
                    color: #080808;
                    background-color: ${typeColors[asset.type] ?? "#444444"};
                    padding: 0.2rem 0.5rem;
                  `}
                >
                  {asset.type}
                </span>
                <span
                  class="font-mono"
                  style="font-size: 0.65rem; letter-spacing: 0.1em; color: #444444;"
                >
                  {asset.size}
                </span>
              </div>

              <!-- File name -->
              <h3
                class="font-mono"
                style="
                  font-size: 0.9rem;
                  font-weight: 700;
                  letter-spacing: 0.04em;
                  color: #F0EDE6;
                  text-transform: uppercase;
                  line-height: 1.3;
                  flex: 1;
                "
              >
                {asset.name}
              </h3>

              <!-- Download button -->
              <a
                href={asset.file}
                download
                class="download-btn font-mono"
                style="
                  display: inline-flex;
                  align-items: center;
                  gap: 0.5rem;
                  font-size: 0.7rem;
                  letter-spacing: 0.2em;
                  text-transform: uppercase;
                  color: #080808;
                  background-color: #C8FF00;
                  padding: 0.75rem 1.25rem;
                  width: fit-content;
                  transition: background-color 0.2s ease, color 0.2s ease;
                  font-weight: 700;
                "
              >
                <span aria-hidden="true">↓</span>
                BAIXAR
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Usage rights note -->
  <section
    style="
      padding: 4rem 3rem 6rem;
    "
  >
    <div style="max-width: 1400px; margin: 0 auto;">
      <div
        class="reveal"
        style="
          border-left: 3px solid color-mix(in srgb, #444444 50%, transparent);
          padding-left: 2rem;
          max-width: 760px;
        "
      >
        <p
          class="font-mono"
          style="font-size: 0.65rem; letter-spacing: 0.2em; color: #444444; text-transform: uppercase; margin-bottom: 1rem;"
        >
          — DIREITOS DE USO
        </p>
        <p
          class="font-body"
          style="font-size: 1.05rem; line-height: 1.7; color: color-mix(in srgb, #F0EDE6 55%, transparent);"
        >
          Os materiais deste kit são disponibilizados exclusivamente para uso editorial, cobertura jornalística e divulgação de eventos oficiais da Obra. É proibida a alteração de logos, uso em contextos comerciais não autorizados ou associação com marcas sem prévia aprovação. Para licenciamento especial, entre em contato via <span style="color: #C8FF00;">press@obra.xyz</span>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .press-card:hover {
    background-color: #1A1A1A !important;
  }

  .download-btn:hover {
    background-color: #F0EDE6 !important;
  }

  @media (max-width: 768px) {
    section {
      padding-left: 1.5rem !important;
      padding-right: 1.5rem !important;
    }

    section > div > div[style*="grid-template-columns: 1fr 1fr"] {
      display: block !important;
    }

    section > div > div[style*="grid-template-columns: 1fr 1fr"] > div:first-child {
      margin-bottom: 3rem;
    }
  }
</style>
