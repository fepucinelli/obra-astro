---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlockRenderer from "../../components/BlockRenderer.astro";
import { getAllPosts } from "../../lib/payload";

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

// Sibling posts for "next post" navigation
const allPosts = await getAllPosts();
const currentIndex = allPosts.findIndex((p) => p.slug === post.slug);
const nextPost = allPosts[currentIndex + 1] ?? null;

function formatDate(date: Date) {
  return date.toLocaleDateString("pt-BR", {
    day: "2-digit",
    month: "long",
    year: "numeric",
  });
}

const categoryLabels: Record<string, string> = {
  "evento-interno": "EVENTO INTERNO",
  "evento-rua": "EVENTO DE RUA",
  "evento-coletivo": "EVENTO COLETIVO",
};

const categoryLabel = categoryLabels[post.category] ?? post.category;
---

<BaseLayout
  title={post.title}
  description={post.description}
  ogImage={post.cover}
  ogType="article"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": post.title,
      "description": post.description ?? "",
      "image": post.cover ?? "",
      "datePublished": post.date.toISOString(),
      "url": `https://obra.xyz/blog/${post.slug}`,
      "publisher": {
        "@type": "Organization",
        "name": "OBRA",
        "url": "https://obra.xyz"
      }
    })} />
  </Fragment>
  <article>
    <!-- Back link -->
    <div
      class="px-6 md:px-12 pt-12 pb-8"
      style="max-width: 1200px; margin: 0 auto;"
    >
      <a
        href="/blog"
        class="font-mono blog-back-link"
      >
        <span aria-hidden="true">←</span>
        BLOG / ARQUIVO
      </a>
    </div>

    <!-- Post header -->
    <header
      class="px-6 md:px-12"
      style="max-width: 1200px; margin: 0 auto; padding-bottom: 3rem;"
    >
      <!-- Category + date row -->
      <div
        style="
          display: flex;
          align-items: center;
          flex-wrap: wrap;
          gap: 1rem;
          margin-bottom: 2rem;
        "
      >
        <span
          class="font-mono"
          style="
            font-size: 0.6rem;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            padding: 0.25rem 0.75rem;
            border: 1px solid #C8FF00;
            color: #C8FF00;
          "
        >
          {categoryLabel}
        </span>

        <time
          datetime={post.date.toISOString()}
          class="font-mono"
          style="
            font-size: 0.65rem;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            color: #444444;
          "
        >
          {formatDate(post.date)}
        </time>
      </div>

      <!-- Title -->
      <h1
        class="font-display reveal"
        style="
          font-size: clamp(2.5rem, 7vw, 6rem);
          font-weight: 800;
          line-height: 1;
          letter-spacing: -0.03em;
          color: #F0EDE6;
          margin: 0 0 2rem 0;
          max-width: 18ch;
        "
      >
        {post.title}
      </h1>

      {post.description && (
        <p
          class="font-body reveal"
          style="
            font-size: 1.25rem;
            line-height: 1.5;
            color: #888888;
            max-width: 60ch;
            margin: 0;
          "
        >
          {post.description}
        </p>
      )}
    </header>

    <!-- Cover image -->
    {post.cover && (
      <div
        class="px-6 md:px-12 reveal"
        style="max-width: 1200px; margin: 0 auto 4rem;"
      >
        <div
          style="
            position: relative;
            overflow: hidden;
            aspect-ratio: 21/9;
            background-color: #1A1A1A;
          "
        >
          <img
            src={post.cover}
            alt={post.title}
            fetchpriority="high"
            loading="eager"
            decoding="async"
            style="
              width: 100%;
              height: 100%;
              object-fit: cover;
              display: block;
              filter: grayscale(15%);
            "
          />
          <div
            style="
              position: absolute;
              inset: 0;
              background: linear-gradient(
                to bottom,
                transparent 60%,
                rgba(8, 8, 8, 0.6) 100%
              );
              pointer-events: none;
            "
          ></div>
        </div>
      </div>
    )}

    <!-- Horizontal rule -->
    <div
      class="px-6 md:px-12"
      style="max-width: 1200px; margin: 0 auto 4rem;"
    >
      <div
        style="
          height: 1px;
          background: linear-gradient(
            to right,
            #C8FF00 60px,
            color-mix(in srgb, #444444 40%, transparent) 60px,
            color-mix(in srgb, #444444 40%, transparent)
          );
        "
      ></div>
    </div>

    <!-- Block content -->
    <div
      class="px-6 md:px-12 reveal"
      style="max-width: 1200px; margin: 0 auto 5rem;"
    >
      <div style="max-width: 72ch;">
        <BlockRenderer blocks={post.layout} />
      </div>
    </div>

    <!-- Tags -->
    {post.tags && post.tags.length > 0 && (
      <div
        class="px-6 md:px-12"
        style="max-width: 1200px; margin: 0 auto 5rem;"
      >
        <div
          style="
            height: 1px;
            background-color: color-mix(in srgb, #444444 30%, transparent);
            margin-bottom: 2rem;
          "
        ></div>
        <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem;">
          <span
            class="font-mono"
            style="font-size: 0.6rem; letter-spacing: 0.2em; color: #444444; text-transform: uppercase;"
          >
            TAGS:
          </span>
          {post.tags.map((tag: string) => (
            <span
              class="font-mono"
              style="
                font-size: 0.6rem;
                letter-spacing: 0.15em;
                text-transform: uppercase;
                padding: 0.2rem 0.6rem;
                border: 1px solid color-mix(in srgb, #444444 60%, transparent);
                color: #888888;
              "
            >
              #{tag}
            </span>
          ))}
        </div>
      </div>
    )}

    <!-- Next post navigation -->
    {nextPost && (
      <nav
        class="px-6 md:px-12 py-12"
        style="
          border-top: 1px solid color-mix(in srgb, #444444 30%, transparent);
          max-width: 100%;
        "
        aria-label="Próxima postagem"
      >
        <div style="max-width: 1200px; margin: 0 auto;">
          <p
            class="font-mono"
            style="
              font-size: 0.6rem;
              letter-spacing: 0.25em;
              text-transform: uppercase;
              color: #444444;
              margin-bottom: 1.25rem;
            "
          >
            — PRÓXIMA POSTAGEM
          </p>

          <a
            href={`/blog/${nextPost.slug}`}
            class="next-post-link"
            style="
              display: flex;
              align-items: flex-start;
              gap: 2rem;
              text-decoration: none;
            "
          >
            {nextPost.cover && (
              <div
                style="
                  width: 120px;
                  flex-shrink: 0;
                  aspect-ratio: 16/9;
                  overflow: hidden;
                  background-color: #1A1A1A;
                "
              >
                <img
                  src={nextPost.cover}
                  alt={nextPost.title}
                  loading="lazy"
                  decoding="async"
                  style="
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                    filter: grayscale(30%);
                    transition: filter 0.2s ease;
                  "
                />
              </div>
            )}

            <div>
              <time
                datetime={nextPost.date.toISOString()}
                class="font-mono"
                style="
                  font-size: 0.6rem;
                  letter-spacing: 0.15em;
                  text-transform: uppercase;
                  color: #444444;
                  display: block;
                  margin-bottom: 0.5rem;
                "
              >
                {formatDate(nextPost.date)}
              </time>

              <h2
                class="next-title font-display"
                style="
                  font-size: clamp(1.25rem, 3vw, 2rem);
                  font-weight: 700;
                  line-height: 1.15;
                  letter-spacing: -0.02em;
                  color: #F0EDE6;
                  margin: 0 0 0.5rem 0;
                  transition: color 0.2s ease;
                  max-width: 30ch;
                "
              >
                {nextPost.title}
              </h2>

              <span
                class="font-mono"
                style="
                  font-size: 0.65rem;
                  letter-spacing: 0.2em;
                  text-transform: uppercase;
                  color: #C8FF00;
                  display: inline-flex;
                  align-items: center;
                  gap: 0.4rem;
                "
              >
                LER <span aria-hidden="true">→</span>
              </span>
            </div>
          </a>
        </div>
      </nav>
    )}
  </article>
</BaseLayout>

<style is:global>
  /* ── Post prose typography ────────────────────────────────── */
  .post-content {
    color: #F0EDE6;
  }

  .post-content h1,
  .post-content h2,
  .post-content h3,
  .post-content h4,
  .post-content h5,
  .post-content h6 {
    font-family: "Syne", system-ui, sans-serif;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: #F0EDE6;
    margin-top: 2.5em;
    margin-bottom: 0.75em;
  }

  .post-content h1 { font-size: 2.25rem; }
  .post-content h2 { font-size: 1.75rem; }
  .post-content h3 { font-size: 1.35rem; }
  .post-content h4 { font-size: 1.1rem; }

  .post-content p {
    font-family: "Barlow Condensed", system-ui, sans-serif;
    font-size: 1.2rem;
    line-height: 1.7;
    color: #c8c5bf;
    margin-top: 0;
    margin-bottom: 1.5em;
  }

  .post-content a {
    color: #C8FF00;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s ease;
  }

  .post-content a:hover {
    color: #F0EDE6;
  }

  .post-content strong {
    color: #C8FF00;
    font-weight: 700;
  }

  .post-content em {
    font-style: italic;
    color: #aaa8a2;
  }

  .post-content ul,
  .post-content ol {
    font-family: "Barlow Condensed", system-ui, sans-serif;
    font-size: 1.2rem;
    line-height: 1.7;
    color: #c8c5bf;
    padding-left: 1.5rem;
    margin-bottom: 1.5em;
  }

  .post-content li {
    margin-bottom: 0.4em;
  }

  .post-content blockquote {
    border-left: 3px solid #C8FF00;
    padding-left: 1.25rem;
    margin: 2em 0;
    color: #888888;
    font-style: italic;
  }

  .post-content blockquote p {
    color: #888888;
  }

  .post-content code {
    font-family: "Space Mono", "Courier New", monospace;
    font-size: 0.875em;
    color: #C8FF00;
    background-color: #1A1A1A;
    padding: 0.15em 0.4em;
    border-radius: 2px;
  }

  .post-content pre {
    background-color: #1A1A1A;
    border: 1px solid color-mix(in srgb, #444444 40%, transparent);
    border-radius: 4px;
    padding: 1.5rem;
    overflow-x: auto;
    margin-bottom: 1.5em;
  }

  .post-content pre code {
    background: none;
    padding: 0;
    color: #F0EDE6;
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .post-content hr {
    border: none;
    border-top: 1px solid color-mix(in srgb, #444444 40%, transparent);
    margin: 3em 0;
  }

  .post-content img {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 2em 0;
  }

  /* ── Back link ─────────────────────────────────────────────── */
  .blog-back-link {
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #444444;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition: color 0.2s ease;
  }
  .blog-back-link:hover {
    color: #C8FF00;
  }

  /* ── Next post navigation ───────────────────────────────────── */
  .next-post-link .next-title {
    transition: color 0.2s ease;
  }
  .next-post-link:hover .next-title {
    color: #C8FF00;
  }
</style>
