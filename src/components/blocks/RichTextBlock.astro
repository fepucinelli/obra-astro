---
interface LexicalNode {
  type: string
  tag?: string
  format?: number
  text?: string
  children?: LexicalNode[]
  url?: string
  listType?: string
  checked?: boolean
  version?: number
  direction?: string | null
}

interface Props {
  content: Record<string, unknown>
}

const { content } = Astro.props

function escapeHtml(str: string): string {
  return str
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
}

function nodeToHTML(node: LexicalNode): string {
  switch (node.type) {
    case 'root':
      return (node.children ?? []).map(nodeToHTML).join('')

    case 'paragraph': {
      const inner = (node.children ?? []).map(nodeToHTML).join('')
      return `<p>${inner || '&nbsp;'}</p>`
    }

    case 'heading': {
      const tag = node.tag ?? 'h2'
      const inner = (node.children ?? []).map(nodeToHTML).join('')
      return `<${tag}>${inner}</${tag}>`
    }

    case 'text': {
      let text = escapeHtml(node.text ?? '')
      const fmt = node.format ?? 0
      if (fmt & 1) text = `<strong>${text}</strong>`
      if (fmt & 2) text = `<em>${text}</em>`
      if (fmt & 8) text = `<u>${text}</u>`
      if (fmt & 16) text = `<code>${text}</code>`
      if (fmt & 4) text = `<s>${text}</s>`
      return text
    }

    case 'link': {
      const href = escapeHtml(node.url ?? '#')
      const inner = (node.children ?? []).map(nodeToHTML).join('')
      return `<a href="${href}" rel="noopener noreferrer">${inner}</a>`
    }

    case 'list': {
      const tag = node.listType === 'number' ? 'ol' : 'ul'
      const inner = (node.children ?? []).map(nodeToHTML).join('')
      return `<${tag}>${inner}</${tag}>`
    }

    case 'listitem': {
      const inner = (node.children ?? []).map(nodeToHTML).join('')
      return `<li>${inner}</li>`
    }

    case 'quote': {
      const inner = (node.children ?? []).map(nodeToHTML).join('')
      return `<blockquote>${inner}</blockquote>`
    }

    case 'horizontalrule':
      return '<hr>'

    case 'linebreak':
      return '<br>'

    default:
      return (node.children ?? []).map(nodeToHTML).join('')
  }
}

const root = (content as { root?: LexicalNode })?.root
const html = root ? nodeToHTML(root) : ''
---

<div class="post-content" set:html={html} />
