---
import EmbedPlayer from '../EmbedPlayer.vue'

interface Props {
  url: string
  caption?: string
}

const { url, caption } = Astro.props
---

<figure style="margin: 2em 0;">
  <div style="border: 1px solid color-mix(in srgb, #444444 30%, transparent); overflow: hidden;">
    <EmbedPlayer url={url} title={caption ?? 'Embed'} client:visible />
  </div>
  {caption && (
    <figcaption
      class="font-mono"
      style="font-size: 0.65rem; letter-spacing: 0.1em; color: #444444; margin-top: 0.5rem; text-align: center;"
    >
      {caption}
    </figcaption>
  )}
</figure>
