{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "plugins": [
      {
        "name": "@vue/typescript-plugin",
        "languages": ["javascript", "typescript", "vue"]
      }
    ]
  },
  "exclude": ["node_modules", "cms"]
}
